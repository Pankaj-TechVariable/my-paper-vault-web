{
  "name": "infra",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "infra": "bin/infra.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy:dev": "cdk deploy -c env=dev",
    "deploy:prod": "cdk deploy -c env=prod",
    "diff:dev": "cdk diff -c env=dev",
    "diff:prod": "cdk diff -c env=prod",
    "synth:dev": "cdk synth -c env=dev",
    "synth:prod": "cdk synth -c env=prod"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1117.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.247.0",
    "constructs": "^10.5.0"
  }
}
